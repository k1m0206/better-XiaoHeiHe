{
  "manifest_version": 3,
  "name": "更好的小黑盒",
  "version": "1.0.0",
  "description": "增强小黑盒网站浏览体验。",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.xiaoheihe.cn/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-xiaoheihe@example.com"
    }
  }
}
